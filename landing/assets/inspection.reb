<style>
  body { font-family: sans-serif; padding: 32px; }
  h1 { border-bottom: 4px solid #f5b700; }
</style>
<h1>Morioh site inspection</h1>
<p>Site location:
  <reb-text name="location" label="Site location"></reb-text>
</p>
<p>Inspector:
  <reb-text name="inspector" label="Inspector"></reb-text>
</p>
<p>Date:
  <reb-date name="date" label="Inspection date"></reb-date>
</p>
<h2>Observations</h2>
<reb-textarea name="observations" label="Observations">
</reb-textarea>
<p>Follow-up:
  <reb-select name="follow_up" label="Follow-up"
    options="Required, Not required"></reb-select>
</p>
<reb-footer>Morioh Works / Fictional inspection</reb-footer>
