{
  "name": "rebar-studio",
  "private": true,
  "version": "1.0.0-beta.2",
  "description": "Rebar Studio: author .reb form templates, fill documents and render them to PDF, offline.",
  "author": "hblabs",
  "license": "GPL-3.0-or-later",
  "repository": "github:vanillaiice/rebar-studio",
  "homepage": "https://github.com/vanillaiice/rebar-studio",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "build:wasm": "sh scripts/build-wasm.sh",
    "predev": "npm run build:wasm",
    "dev": "vite",
    "prebuild": "npm run build:wasm",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "npm run build && electron .",
    "electron:pack": "npm run build && electron-builder --dir",
    "electron:dist": "npm run build && electron-builder --publish never",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:fidelity": "FIDELITY=1 vitest run test/fidelity.test.ts",
    "release": "npm run build && electron-builder --publish always"
  },
  "build": {
    "appId": "com.hblabs.rebarstudio",
    "productName": "Rebar Studio",
    "copyright": "Copyright (C) 2026 hblabs",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png"
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "generateUpdatesFilesForAllChannels": true,
    "publish": [
      {
        "provider": "github",
        "owner": "vanillaiice",
        "repo": "rebar-studio"
      }
    ],
    "fileAssociations": [
      {
        "ext": "reb",
        "name": "Rebar template",
        "description": "Rebar form template",
        "mimeType": "application/x-reb",
        "role": "Editor"
      },
      {
        "ext": "rebpack",
        "name": "Rebar template pack",
        "description": "Rebar template with its images",
        "mimeType": "application/x-rebpack",
        "role": "Editor"
      },
      {
        "ext": "rebdoc",
        "name": "Rebar document",
        "description": "Filled Rebar document",
        "mimeType": "application/x-rebdoc",
        "role": "Editor"
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "executableName": "rebar-studio",
      "synopsis": "Author .reb form templates, fill documents, render PDFs offline",
      "maintainer": "hblabs <vanillaiice@tutanota.com>"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "portable": {
      "artifactName": "${productName}-${version}-${os}-${arch}-portable.${ext}"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "hardenedRuntime": true
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "clsx": "^2.1.1",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "fake-indexeddb": "^6.2.5",
    "fflate": "^0.8.3",
    "globals": "^17.6.0",
    "idb": "^8.0.3",
    "jsdom": "^30.1.1",
    "lucide-react": "^1.16.0",
    "marked": "^18.0.14",
    "monaco-editor": "^0.55.1",
    "monaco-vim": "^0.4.4",
    "pdfjs-dist": "^6.3.289",
    "postcss": "^8.5.15",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3"
  }
}
