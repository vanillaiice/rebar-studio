{
  "name": "rebar-studio",
  "private": true,
  "version": "1.0.0",
  "description": "Rebar Studio - WYSIWYG editor for .reb form templates with a live PDF preview.",
  "author": "hblabs",
  "license": "GPL-3.0-or-later",
  "repository": "github:vanillaiice/rebar-studio",
  "homepage": "https://github.com/vanillaiice/rebar-studio",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "build:wasm": "sh scripts/build-wasm.sh",
    "predev": "npm run build:wasm",
    "dev": "vite",
    "prebuild": "npm run build:wasm",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "npm run build && electron .",
    "electron:pack": "npm run build && electron-builder --dir",
    "electron:dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.rebar.studio",
    "productName": "Rebar Studio",
    "directories": {
      "output": "release"
    },
    "files": ["dist/**/*", "electron/**/*"],
    "linux": {
      "target": ["AppImage"],
      "category": "Development",
      "executableName": "rebar-studio",
      "synopsis": "WYSIWYG editor for .reb form templates",
      "syncDesktopName": true
    },
    "win": {
      "target": ["nsis", "portable"]
    },
    "mac": {
      "target": ["dmg"]
    }
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tailwindcss/vite": "^4.3.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "monaco-editor": "^0.55.1",
    "monaco-vim": "^0.4.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
